#!/usr/bin/env bash

set -euo pipefail

export SHELL="${SHELL:-/bin/bash}"

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIGDIR="${BASEDIR}/meta/config"
DOTBOT="${BASEDIR}/installer/dotbot/bin/dotbot"
PLUGINDIR="${BASEDIR}/installer/plugins"

if [[ ! -x "${DOTBOT}" || ! -e "${PLUGINDIR}/dotbot-ifplatform/lib/distro/.git" ]]; then
  git -C "${BASEDIR}" submodule update --init --recursive
fi

declare -a REQUESTED_CONFIGS=("base")
declare -a FLAGS=()
while (( "$#" )); do
  case "$1" in
    -*)
      FLAGS+=("$1")
      ;;
    *)
      REQUESTED_CONFIGS+=("$1")
      ;;
  esac
  shift
done

TMPCONFIG="$(mktemp "${TMPDIR:-/tmp}/dotbot.XXXXXX.yaml")"
trap 'rm -f "${TMPCONFIG}"' EXIT

declare -a SEEN_CONFIGS=()
for config in "${REQUESTED_CONFIGS[@]}"; do
  already_seen=0
  for seen in "${SEEN_CONFIGS[@]+"${SEEN_CONFIGS[@]}"}"; do
    if [[ "${seen}" == "${config}" ]]; then
      already_seen=1
      break
    fi
  done
  if (( already_seen )); then
    continue
  fi
  SEEN_CONFIGS+=("${config}")

  config_path="${CONFIGDIR}/${config}.yaml"
  if [[ ! -f "${config_path}" ]]; then
    echo "Error: configuration '${config}' not found at ${config_path}" >&2
    exit 1
  fi
  echo "Adding configuration ${config}"
  cat "${config_path}" >> "${TMPCONFIG}"
  printf '\n' >> "${TMPCONFIG}"
done

declare -a PLUGINS=(
  "--plugin-dir" "${PLUGINDIR}"
  "--plugin-dir" "${PLUGINDIR}/dotbot-ifplatform"
  "--plugin-dir" "${PLUGINDIR}/dotbot-template"
)

"${DOTBOT}" ${FLAGS[@]+"${FLAGS[@]}"} -d "${BASEDIR}" "${PLUGINS[@]}" -c "${TMPCONFIG}"
