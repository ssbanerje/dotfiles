#!/usr/bin/env bash

set -euo pipefail

export SHELL="${SHELL:-/bin/bash}"

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIGDIR="${BASEDIR}/meta/config"
DOTBOT="${BASEDIR}/installer/dotbot/bin/dotbot"
PLUGINDIR="${BASEDIR}/installer/plugins"

if [[ ! -x "${DOTBOT}" || ! -e "${PLUGINDIR}/dotbot-ifplatform/lib/distro/.git" || ! -e "${PLUGINDIR}/dotbot-template/lib/jinja/.git" ]]; then
  git -C "${BASEDIR}" submodule update --init --recursive
fi

declare -a REQUESTED_CONFIGS=("base")
declare -a FLAGS=()
declare -a ONLY_DIRECTIVES=()
declare -a SKIP_DIRECTIVES=()
HAS_ONLY=0
HAS_SKIP=0

while (( "$#" )); do
  case "$1" in
    --)
      shift
      while (( "$#" )); do
        REQUESTED_CONFIGS+=("$1")
        shift
      done
      break
      ;;
    -d|--base-directory|-p|--plugin|--plugin-dir)
      if (( "$#" < 2 )); then
        echo "Error: option '$1' requires an argument" >&2
        exit 1
      fi
      FLAGS+=("$1" "$2")
      shift 2
      ;;
    --only)
      HAS_ONLY=1
      shift
      while (( "$#" )) && [[ "$1" != -* ]]; do
        ONLY_DIRECTIVES+=("$1")
        shift
      done
      ;;
    --except)
      HAS_SKIP=1
      shift
      while (( "$#" )) && [[ "$1" != -* ]]; do
        SKIP_DIRECTIVES+=("$1")
        shift
      done
      ;;
    -*)
      FLAGS+=("$1")
      shift
      ;;
    *)
      REQUESTED_CONFIGS+=("$1")
      shift
      ;;
  esac
done

declare -a SEEN_CONFIGS=()
declare -a CONFIG_FILES=()
for config in "${REQUESTED_CONFIGS[@]}"; do
  already_seen=0
  for seen in ${SEEN_CONFIGS[@]+"${SEEN_CONFIGS[@]}"}; do
    if [[ "${seen}" == "${config}" ]]; then
      already_seen=1
      break
    fi
  done
  if (( already_seen )); then
    continue
  fi
  SEEN_CONFIGS+=("${config}")

  config_path="${CONFIGDIR}/${config}.yaml"
  if [[ ! -f "${config_path}" ]]; then
    echo "Error: configuration '${config}' not found at ${config_path}" >&2
    exit 1
  fi
  echo "Adding configuration ${config}"
  CONFIG_FILES+=("${config_path}")
done

if (( HAS_ONLY )); then
  if [[ "${#ONLY_DIRECTIVES[@]}" -eq 0 ]]; then
    echo "Error: option '--only' requires at least one directive" >&2
    exit 1
  fi
  ONLY_DIRECTIVES+=("plugins")
  while IFS= read -r directive; do
    if [[ -n "${directive}" ]]; then
      ONLY_DIRECTIVES+=("${directive}")
    fi
  done < <(sed -nE 's/^[[:space:]]*-[[:space:]]*(if(not)?[a-z0-9_]+):.*/\1/p' "${CONFIG_FILES[@]}" | sort -u)
  FLAGS+=("--only" "${ONLY_DIRECTIVES[@]}")
fi

if (( HAS_SKIP )); then
  if [[ "${#SKIP_DIRECTIVES[@]}" -eq 0 ]]; then
    echo "Error: option '--except' requires at least one directive" >&2
    exit 1
  fi
  FLAGS+=("--except" "${SKIP_DIRECTIVES[@]}")
fi

exec "${DOTBOT}" ${FLAGS[@]+"${FLAGS[@]}"} -d "${BASEDIR}" -c "${CONFIG_FILES[@]}"
