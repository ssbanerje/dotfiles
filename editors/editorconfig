root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{*.py,*.rs,*.cmake,CMakeLists.txt}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile,*.mk,.gitmodules,*.go}]
indent_style = tab
indent_size = 4

