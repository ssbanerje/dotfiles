#!/usr/bin/env bash
# ftwind - switch window via fzf popup
set -euo pipefail

windows="$(
  tmux list-windows -F $'#I\t#{window_active}\t#{window_name}\t#{pane_current_path}' \
    | awk -F'\t' '{
        dir = $4
        sub(".*/", "", dir)
        if (dir == "") dir = "/"
        mark = ($2 == "1") ? "*" : " "
        color = ($2 == "1") ? "\033[32m" : ""
        reset = ($2 == "1") ? "\033[0m" : ""
        printf "%s %s%-3s%s  %-20s  %s\n", mark, color, $1, reset, $3, dir
      }'
)"

[[ -z "$windows" ]] && exit 0

target="$(printf '%s\n' "$windows" | fzf --reverse --ansi --no-multi --prompt='window> ')" || exit 0
target_window="$(awk '{ print ($1 == "*") ? $2 : $1 }' <<< "$target")"

tmux select-window -t "$target_window"
