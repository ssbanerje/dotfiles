#!/usr/bin/env sh
# Usage: ports [<options>]
# Show processes listening on TCP ports without reverse-DNS delays.
# Extra <options> are passed through to lsof (or ss fallback on Linux).
set -eu

case "${1:-}" in
  -h|--help)
    sed -n '2,4s/^# //p' "$0"
    exit 0
    ;;
esac

if command -v lsof >/dev/null 2>&1; then
  exec lsof -iTCP -sTCP:LISTEN -P -n "$@"
elif command -v ss >/dev/null 2>&1; then
  exec ss -ltnp "$@"
else
  echo "ports: neither 'lsof' nor 'ss' is installed" >&2
  exit 1
fi
