#!/usr/bin/env bash
# ftpane - switch pane via fzf popup
set -euo pipefail

current_pane="$(tmux display-message -p '#I.#P')"
panes="$(
  tmux list-panes -s -F $'#I.#P\t#{window_name}\t#{pane_current_command}\t#{pane_current_path}' \
    | awk -F'\t' -v cur="$current_pane" '$1 != cur { printf "%-6s  %-16s  %-14s  %s\n", $1, $2, $3, $4 }'
)"

[[ -z "$panes" ]] && exit 0

target="$(printf '%s\n' "$panes" | fzf --reverse --no-multi --prompt='pane> ')" || exit 0
target_id="${target%% *}"

tmux select-window -t "${target_id%.*}"
tmux select-pane -t "$target_id"
