#!/usr/bin/env bash

# Create tar.gz archives and remove original paths once verified
# Usage: gzball [-q] PATH [PATH ...]

set -euo pipefail

tar_flags=(-czf)
if [[ "${1:-}" == "-q" ]]; then
  shift
else
  tar_flags=(-czvf)
fi

if [[ "$#" -eq 0 ]]; then
  echo "Usage: gzball [-q] PATH [PATH ...]" >&2
  exit 1
fi

for target in "$@"; do
  clean="${target%/}"
  archive="${clean}.tar.gz"
  echo "${archive}"
  tar "${tar_flags[@]}" "${archive}" -- "${clean}"
  tar -tzf "${archive}" >/dev/null
  touch -r "${clean}" "${archive}"
  rm -rf -- "${clean}"
done
