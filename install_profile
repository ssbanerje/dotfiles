#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILESDIR="${BASEDIR}/meta/profiles"

declare -a ARGS=()
declare -a FLAGS=()
while (( "$#" )); do
  case "$1" in
    --)
      shift
      while (( "$#" )); do
        ARGS+=("$1")
        shift
      done
      break
      ;;
    -d|--base-directory|-p|--plugin|--plugin-dir)
      if (( "$#" < 2 )); then
        echo "Error: option '$1' requires an argument" >&2
        exit 1
      fi
      FLAGS+=("$1" "$2")
      shift 2
      ;;
    --only|--except)
      flag="$1"
      FLAGS+=("${flag}")
      shift
      count=0
      while (( "$#" )) && [[ "$1" != -* ]]; do
        FLAGS+=("$1")
        count=$(( count + 1 ))
        shift
      done
      if (( count == 0 )); then
        echo "Error: option '${flag}' requires at least one directive" >&2
        exit 1
      fi
      ;;
    -*)
      FLAGS+=("$1")
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "${#ARGS[@]}" -eq 0 ]]; then
  echo "Usage: $0 [dotbot-flags...] <profile> [extra-configs...]" >&2
  exit 1
fi

set -- "${ARGS[@]}"
PROFILE_FILE="${PROFILESDIR}/$1"
if [[ ! -f "${PROFILE_FILE}" ]]; then
  echo "Error: profile '$1' not found at ${PROFILE_FILE}" >&2
  exit 1
fi
shift

declare -a CONFIGS=()
while IFS= read -r config || [[ -n "${config}" ]]; do
  if [[ -n "${config}" && "${config}" != \#* ]]; then
    CONFIGS+=("${config}")
  fi
done < "${PROFILE_FILE}"

exec "${BASEDIR}/install" ${FLAGS[@]+"${FLAGS[@]}"} -- "${CONFIGS[@]}" "$@"
