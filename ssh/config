# Machine-local overrides (first-match-wins in OpenSSH)
Include ~/.ssh/config.d/*.conf ~/.ssh/config.local

Host github.com
  User git
  Hostname github.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_ed25519

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  HashKnownHosts yes
  TCPKeepAlive yes
  ServerAliveInterval 15
  ServerAliveCountMax 6
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa
