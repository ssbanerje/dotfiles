[submodule "git/gitignore"]
  path = git/gitignore
  url = https://github.com/github/gitignore.git
[submodule "shell/tpm"]
	path = tmux/tpm
	url = https://github.com/tmux-plugins/tpm.git
[submodule "installer/dotbot"]
	path = installer/dotbot
  url = https://github.com/anishathalye/dotbot.git
  ignore = dirty
[submodule "installer/dotbot-ifplatform"]
	path = installer/plugins/dotbot-ifplatform
	url = https://github.com/ssbanerje/dotbot-ifplatform.git
[submodule "installer/dotbot-template"]
	path = installer/plugins/dotbot-template
	url = https://github.com/ssbanerje/dotbot-template.git
[submodule "installer/dotbot-sudo"]
	path = installer/plugins/dotbot-sudo
	url = https://github.com/DrDynamic/dotbot-sudo.git
[submodule "installer/dotbot-pip"]
	path = installer/plugins/dotbot-pip
	url = https://github.com/sobolevn/dotbot-pip.git
