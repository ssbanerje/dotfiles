# Automatically normalize line endings for all text-based files
* text=auto

# Semantic hunk headers for source & document files
*.bash diff=bash
*.bib  diff=bibtex
*.c    diff=cpp
*.cc   diff=cpp
*.cpp  diff=cpp
*.go   diff=golang
*.h    diff=cpp
*.hpp  diff=cpp
*.md   diff=markdown
*.py   diff=python
*.rs   diff=rust
*.sh   diff=bash
*.tex  diff=tex
*.zsh  diff=bash

# Binary formats (omit text diffs and CRLF mangling; note *.svg stays diffable XML)
*.eot   binary
*.fla   binary
*.flv   binary
*.gif   binary
*.gz    binary
*.ico   binary
*.jpeg  binary
*.jpg   binary
*.m4v   binary
*.mov   binary
*.mp4   binary
*.ogv   binary
*.otf   binary
*.pdf   binary
*.png   binary
*.swf   binary
*.ttf   binary
*.webm  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.xz    binary
*.zip   binary
*.zst   binary
