[core]
  whitespace = fix,space-before-tab,tab-in-indent,trailing-space
  quotepath = false
  excludesfile = {{HOME_DIR}}/.global_gitignore

[apply]
  whitespace = fix

[user]
  name = {{NAME}}
  email = {{EMAIL}}

[sendmail]
  smtpserver = {{SMTP_SERVER}}
  smtpserverport = {{SMTP_PORT}}
  smtpencryption = {{SMTP_ENCRYPTION}}
  smtpuser = {{EMAIL}}
  from = {{EMAIL}}

[github]
  user = {{GITHUB_USERNAME}}

[difftool]
  prompt = false

[credential]
  helper = {{CREDENTIAL_HELPER}}

[diff]
  algorithm = histogram
  colorMoved = default
  renames = copy
  tool = nvimdiff
  wordRegex = [^[:space:]]
  mnemonicprefix = true

[merge]
  conflictStyle = zdiff3
  log = true
  tool = nvimdiff

[mergetool]
  keepBackup = false

[rerere]
  enabled = true

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
  interactive = auto

[branch]
  autoSetupMerge = true
  autoSetupRebase = always

[alias]
  root  = rev-parse --show-toplevel
  st    = status --short --branch --ignore-submodules=untracked
  # [b]ranch
  bc    = checkout
  bcn   = checkout -b
  bd    = branch -D
  bi    = branch --verbose
  # [l]og
  la    = log --graph --decorate --pretty=oneline --abbrev-commit --all
  ll    = log --graph --decorate --pretty=oneline --abbrev-commit
  # [p]push
  p     = !git push && git push --tags
  # [r]emote
  ra    = remote add
  rl    = remote -v
  rrm   = remote rm
  # [r]eset
  R     = reset --hard HEAD
  # [s]ubmodule
  scm   = submodule foreach --recursive git checkout master
  sl    = submodule --quiet foreach --recursive echo $path  on  $(git rev-parse --abbrev-ref HEAD)
  su    = !git submodule sync && git submodule update --init --recursive
  # [u]pdate
  uo    = !git fetch -v origin && git remote update origin --prune
  uu    = !git fetch -v upstream && git remote update upstream --prune

[push]
  default = simple
  autoSetupRemote = true

