[core]
  whitespace = fix,space-before-tab,tab-in-indent,trailing-space
  quotepath = false
  excludesfile = {{HOME_DIR}}/.global_gitignore
  attributesfile = {{HOME_DIR}}/.gitattributes
  trustctime = false
  precomposeUnicode = true

[init]
  defaultBranch = main

[apply]
  whitespace = fix

[user]
  name = {{NAME}}
  email = {{EMAIL}}

[sendmail]
  smtpserver = {{SMTP_SERVER}}
  smtpserverport = {{SMTP_PORT}}
  smtpencryption = {{SMTP_ENCRYPTION}}
  smtpuser = {{EMAIL}}
  from = {{EMAIL}}

[github]
  user = {{GITHUB_USERNAME}}

[difftool]
  prompt = false

[credential]
  helper = {{CREDENTIAL_HELPER}}

[column]
  ui = auto

[diff]
  algorithm = histogram
  colorMoved = default
  renames = copy
  submodule = log
  tool = nvimdiff
  wordRegex = [^[:space:]]
  mnemonicprefix = true

[merge]
  conflictStyle = zdiff3
  log = true
  tool = nvimdiff

[mergetool]
  keepBackup = false

[rerere]
  enabled = true
  autoupdate = true

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
  interactive = auto

[branch]
  autoSetupMerge = true
  autoSetupRebase = always
  sort = -committerdate

[tag]
  sort = version:refname

[fetch]
  prune = true
  pruneTags = true
  all = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true

[commit]
  verbose = true

[stash]
  showPatch = true

[submodule]
  fetchJobs = 4

[help]
  autocorrect = prompt

[alias]
  root  = rev-parse --show-toplevel
  st    = status --short --branch --ignore-submodules=untracked
  amend = commit --amend --no-edit
  unstage = restore --staged
  last  = log -1 HEAD --stat
  aliases = config --get-regexp ^alias\\.
  contributors = shortlog --summary --numbered
  whoami = !git config user.name && git config user.email
  # [b]ranch
  bc    = checkout
  bcn   = checkout -b
  bd    = branch -D
  bi    = branch --verbose
  # [l]og
  la    = log --graph --decorate --pretty=oneline --abbrev-commit --all
  ll    = log --graph --decorate --pretty=oneline --abbrev-commit
  # [p]push
  p     = !git push && git push --tags
  pf    = push --force-with-lease --force-if-includes
  # [r]emote
  ra    = remote add
  rl    = remote -v
  rrm   = remote rm
  # [r]eset
  R     = reset --hard HEAD
  # [s]ubmodule
  scm   = submodule foreach --recursive git checkout master
  sl    = submodule --quiet foreach --recursive echo $path  on  $(git rev-parse --abbrev-ref HEAD)
  su    = !git submodule sync && git submodule update --init --recursive
  # [u]pdate
  uo    = !git fetch -v origin && git remote update origin --prune
  uu    = !git fetch -v upstream && git remote update upstream --prune

[push]
  default = simple
  autoSetupRemote = true

[include]
  path = ~/.gitconfig.local

