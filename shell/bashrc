#!/usr/bin/env bash

# Bash Options {{{
HISTCONTROL=ignoreboth:ignoredups:ignorespace
shopt -s histappend
shopt -s checkwinsize
# }}}

function _check_and_source() {
  local f
  for f in "$@"; do
    [[ -n "$f" && -r "$f" ]] && source "$f"
  done
}

# Environment variables & aliases
_check_and_source \
  "$HOME/.config/env.sh" \
  "$HOME/.config/aliases.sh"

# Skip the remaining file for non-interactive shells
if [[ "$-" != *i* ]]; then
  unset -f _check_and_source
  return
fi

# Bash Completion + Keybindings {{{

if [[ "$UNAME" == "Linux" ]]; then
  shopt -oq posix || _check_and_source /usr/share/bash-completion/bash_completion
  _check_and_source \
    /usr/share/doc/fzf/examples/completion.bash \
    /usr/share/doc/fzf/examples/key-bindings.bash \
    /usr/share/fzf/completion.bash \
    /usr/share/fzf/key-bindings.bash
elif [[ "$UNAME" == "Darwin" && -n "${BREW_PREFIX:-}" ]]; then
  _check_and_source \
    "$BREW_PREFIX/etc/profile.d/bash_completion.sh" \
    "$BREW_PREFIX/opt/fzf/shell/completion.bash" \
    "$BREW_PREFIX/opt/fzf/shell/key-bindings.bash"
  if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
    _check_and_source "$HOME/.config/iterm2_shell_integration.bash"
  fi
fi

# }}}

# Set vi mode
set -o vi

# Theme
_check_and_source "$HOME/.config/bash_prompt.sh"

unset -f _check_and_source

