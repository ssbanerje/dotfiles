# When following a redirect, automatically set the previous URL as referer.
referer = ";auto"

# Wait 60 seconds before timing out.
connect-timeout = 60

# Follow HTTP/HTTPS redirects only (prevent open-redirect scheme downgrades).
location
proto-redir = -all,http,https

# Require TLS 1.2 or newer.
tlsv1.2

# Display progress as a simple progress bar.
progress-bar

# Show error messages.
show-error
