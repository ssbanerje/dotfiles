#!/usr/bin/env zsh

# ZSH Options {{{

HISTSIZE=10000
SAVEHIST=10000
setopt AUTOCD
setopt ALWAYS_TO_END COMPLETE_IN_WORD
setopt AUTOPUSHD PUSHDMINUS PUSHDSILENT PUSHDTOHOME PUSHDIGNOREDUPS
setopt CORRECT
setopt COMPLETE_ALIASES
setopt EXTENDED_GLOB
setopt HIST_EXPIRE_DUPS_FIRST HIST_FIND_NO_DUPS HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
setopt LOCAL_OPTIONS LOCAL_TRAPS

# }}}

# Setup environment {{{

source "$HOME/.config/env.sh"
source "$HOME/.p10k.zsh"

# Setup Homebrew FPATH without spawning `brew --prefix`
if [[ "$UNAME" == "Darwin" && -n "$BREW_PREFIX" ]]; then
  typeset site_fn="$BREW_PREFIX/share/zsh/site-functions"
  if [[ -d "$site_fn" ]] && (( ! ${fpath[(Ie)$site_fn]} )); then
    fpath=("$site_fn" $fpath)
  fi
  unset site_fn
fi

# }}}

# Skip the remaining file for non-interactive shells
[[ "$-" == *i* ]] || return

# Load Plugins {{{

export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true

# Initialize zsh-vi-mode immediately so subsequent plugin/user keymaps persist
export ZVM_INIT_MODE=sourcing

# OMZ plugin configuration (must precede bundle load)
zstyle ':omz:plugins:gpg-agent' ssh-support no
zstyle ':omz:plugins:ssh-agent' quiet yes
zstyle ':omz:plugins:ssh-agent' lazy yes
zstyle ':omz:plugins:ssh-agent' agent-forwarding yes
if [[ "$UNAME" == "Darwin" ]]; then
  zstyle ':omz:plugins:ssh-agent' ssh-add-args --apple-load-keychain
  zstyle ':omz:plugins:iterm2' shell-integration yes
fi

function _bootstrap_plugins() {
  local zsh_plugins="$HOME/.zsh_plugins.zsh"
  local -a plugin_files=("$HOME/.config/zsh_plugins.txt")

  if [[ "$UNAME" == "Darwin" ]]; then
    plugin_files+=("$HOME/.config/zsh_plugins_macos.txt")
  elif [[ "$UNAME" == "Linux" ]]; then
    if (( $+commands[apt-get] )); then
      plugin_files+=("$HOME/.config/zsh_plugins_ubuntu.txt")
    elif (( $+commands[pacman] )); then
      plugin_files+=("$HOME/.config/zsh_plugins_arch.txt")
    fi
  fi

  local regenerate=false
  if [[ ! -f "$zsh_plugins" ]]; then
    regenerate=true
  else
    local f
    for f in "${plugin_files[@]}"; do
      if [[ "$f" -nt "$zsh_plugins" ]]; then
        regenerate=true
        break
      fi
    done
  fi

  if $regenerate; then
    source "$HOME/.config/antidote/antidote.zsh"
    zstyle ':antidote:*' zcompile 'yes'
    antidote bundle < <(cat "${plugin_files[@]}") >|"$zsh_plugins"
    zcompile "$zsh_plugins" 2>/dev/null || true
  fi

  source "$zsh_plugins"
}
_bootstrap_plugins
unset -f _bootstrap_plugins

# Make fancy-ctrl-z work in zsh-vi-mode insert mode
zvm_define_widget fancy-ctrl-z fancy-ctrl-z
zvm_bindkey viins '^Z' fancy-ctrl-z

# }}}

# Completion styling {{{

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#) ([0-9a-z-]#)*=01;34=0=01'
zstyle ':completion:*:*:*:*:processes' command "ps -u $USER -o pid,user,comm -w -w"
zstyle ':completion:*:ssh:*' tag-order hosts users
zstyle ':completion:*:ssh:*' group-order hosts-domain hosts-host users hosts-ipaddr
zstyle ':completion:*:functions' ignored-patterns '_*'
zstyle ':completion:*:*:kill:*' menu yes select

# }}}

# Load aliases deferred
[[ -r "$HOME/.config/aliases.sh" ]] && zsh-defer source "$HOME/.config/aliases.sh"

